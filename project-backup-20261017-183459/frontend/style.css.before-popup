:root {
    --bg: #f6f4fc;
    --surface: #ffffff;
    --surface-soft: #f3efff;
    --text: #241c3a;
    --muted: #817a93;
    --purple: #7652df;
    --purple-dark: #5935bb;
    --border: #e9e4f3;
    --shadow: 0 8px 30px rgba(57, 34, 102, 0.06);
}

body.dark {
    --bg: #151122;
    --surface: #211a32;
    --surface-soft: #302544;
    --text: #f6f1ff;
    --muted: #b5a8cb;
    --purple: #a78bfa;
    --purple-dark: #8b5cf6;
    --border: #3b3050;
    --shadow: 0 8px 30px rgba(0, 0, 0, 0.15);
}

* {
    box-sizing: border-box;
}

html {
    scroll-behavior: smooth;
}

body {
    margin: 0;
    font-family: "Segoe UI", Arial, sans-serif;
    background: var(--bg);
    color: var(--text);
    transition: background .2s, color .2s;
}

button, input, textarea, select {
    font: inherit;
}

button {
    cursor: pointer;
}

.app-shell {
    display: flex;
    min-height: 100vh;
}

.sidebar {
    width: 240px;
    flex-shrink: 0;
    background: #21183b;
    color: white;
    padding: 28px 18px;
    display: flex;
    flex-direction: column;
    position: sticky;
    top: 0;
    height: 100vh;
}

.brand {
    font-size: 24px;
    font-weight: 800;
    display: flex;
    align-items: center;
    gap: 10px;
    padding: 4px 12px 34px;
}

.brand-icon {
    color: #bca3ff;
    font-size: 32px;
}

.sidebar-label {
    color: #a99ac7;
    font-size: 11px;
    letter-spacing: 2px;
    padding: 0 14px;
}

.navigation {
    display: grid;
    gap: 7px;
    margin-top: 12px;
}

.nav-link {
    color: #d2c8e8;
    text-decoration: none;
    padding: 13px 15px;
    border-radius: 11px;
}

.nav-link:hover,
.nav-link.active {
    background: #48346e;
    color: white;
}

.sidebar-bottom {
    margin-top: auto;
    padding: 15px 8px;
    color: #c3b6dd;
    font-size: 13px;
}

.theme-button {
    width: 100%;
    margin-top: 12px;
    padding: 12px;
    background: #48346e;
    border: 0;
    border-radius: 10px;
    color: white;
}

.main-content {
    flex: 1;
    min-width: 0;
    max-width: 1500px;
    padding: 35px 42px;
}

.topbar,
.section-heading,
.progress-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 15px;
}

.topbar {
    margin-bottom: 32px;
}

h1 {
    font-size: 30px;
    margin: 6px 0;
}

h2 {
    font-size: 20px;
    margin: 0;
}

h3 {
    margin: 0;
}

.eyebrow {
    color: var(--purple);
    font-size: 11px;
    font-weight: 800;
    letter-spacing: 2px;
}

.subtitle,
.muted,
.section-note,
.progress-heading p {
    color: var(--muted);
}

.primary-link,
.primary-button {
    display: inline-block;
    border: 0;
    background: #7652df;
    color: white;
    text-decoration: none;
    border-radius: 10px;
    padding: 13px 20px;
    font-weight: 600;
}

.primary-link:hover,
.primary-button:hover {
    background: #5935bb;
}

.stats-grid {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 16px;
    margin: 20px 0;
}

.stat-card,
.panel {
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 18px;
    box-shadow: var(--shadow);
}

.stat-card {
    padding: 22px;
}

.stat-icon {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    width: 38px;
    height: 38px;
    border-radius: 10px;
    color: #7652df;
    background: #eee8ff;
    font-size: 22px;
}

.stat-icon.amber {
    color: #c47b0a;
    background: #fff0d4;
}

.stat-icon.green {
    color: #138657;
    background: #d9f8e9;
}

.stat-icon.red {
    color: #d44765;
    background: #ffe2e8;
}

.stat-card p {
    color: var(--muted);
    font-size: 13px;
}

.stat-card h3 {
    font-size: 32px;
}

.panel {
    padding: 26px;
    margin-bottom: 24px;
}

.progress-panel {
    margin-top: 20px;
}

.progress-heading strong {
    font-size: 28px;
    color: var(--purple);
}

.progress-track {
    height: 12px;
    background: var(--surface-soft);
    border-radius: 30px;
    overflow: hidden;
    margin: 22px 0 12px;
}

.progress-fill {
    width: 0;
    height: 100%;
    background: linear-gradient(90deg, #7652df, #bd86f5);
    border-radius: 30px;
    transition: width .3s;
}

.field {
    display: flex;
    flex-direction: column;
    gap: 8px;
    margin-top: 18px;
}

.field label {
    font-size: 13px;
    font-weight: 600;
}

input, textarea, select {
    width: 100%;
    background: var(--surface);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 10px;
    padding: 12px 14px;
    outline-color: var(--purple);
}

textarea {
    min-height: 90px;
    resize: vertical;
}

.form-grid {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 0 18px;
}

.form-actions {
    display: flex;
    gap: 12px;
    margin-top: 22px;
}

.secondary-button,
.task-actions button {
    background: var(--surface-soft);
    color: var(--text);
    border: 1px solid var(--border);
    border-radius: 9px;
    padding: 10px 14px;
}

[hidden] {
    display: none !important;
}

.search-bar {
    margin: 20px 0 12px;
}

.filters {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: 12px;
    margin-bottom: 20px;
}

.task-list {
    display: grid;
    gap: 12px;
}

.task {
    padding: 18px;
    border: 1px solid var(--border);
    border-radius: 13px;
    background: var(--surface);
}

.task.completed h3 {
    text-decoration: line-through;
    opacity: .65;
}

.task h3 {
    font-size: 16px;
}

.task p {
    color: var(--muted);
    font-size: 13px;
    line-height: 1.6;
}

.task-meta {
    display: flex;
    gap: 8px;
    flex-wrap: wrap;
    margin-top: 12px;
}

.tag {
    padding: 5px 9px;
    border-radius: 7px;
    background: var(--surface-soft);
    color: var(--purple);
    font-size: 12px;
}

.tag.high {
    color: #e34c6f;
    background: #ffe8ee;
}

.tag.medium {
    color: #b9780d;
    background: #fff1d7;
}

.tag.low {
    color: #148858;
    background: #dff8eb;
}

.task-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin-top: 15px;
}

.task-actions button.danger {
    color: #dc4562;
}

.message {
    color: var(--purple);
    min-height: 20px;
    font-size: 13px;
}

.calendar-controls {
    display: flex;
    align-items: center;
    gap: 12px;
}

.calendar-controls button {
    border: 1px solid var(--border);
    border-radius: 8px;
    background: var(--surface-soft);
    color: var(--text);
    padding: 6px 12px;
    font-size: 20px;
}

.calendar {
    display: grid;
    grid-template-columns: repeat(7, minmax(0, 1fr));
    gap: 7px;
    margin-top: 22px;
}

.calendar-weekday {
    text-align: center;
    font-size: 12px;
    font-weight: 700;
    color: var(--muted);
    padding: 10px 0;
}

.calendar-day {
    min-height: 72px;
    background: var(--surface);
    border: 1px solid var(--border);
    border-radius: 9px;
    color: var(--text);
    padding: 9px;
    text-align: left;
}

.calendar-day.today {
    border-color: var(--purple);
}

.calendar-day.selected {
    background: var(--surface-soft);
    border: 2px solid var(--purple);
}

.calendar-day.has-tasks::after {
    content: "";
    display: block;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--purple);
    margin-top: 8px;
}

.calendar-day:disabled {
    opacity: .25;
    cursor: default;
}

.calendar-details {
    margin-top: 18px;
    padding: 15px;
    background: var(--surface-soft);
    border-radius: 10px;
    font-size: 13px;
}

.calendar-details p {
    margin: 7px 0;
}

.footer {
    text-align: center;
    padding: 20px;
    color: var(--muted);
    font-size: 12px;
}

@media (max-width: 1050px) {
    .stats-grid {
        grid-template-columns: repeat(2, 1fr);
    }

    .sidebar {
        width: 195px;
    }

    .main-content {
        padding: 28px;
    }
}

@media (max-width: 700px) {
    .app-shell {
        display: block;
    }

    .sidebar {
        width: 100%;
        height: auto;
        position: static;
        padding: 16px;
    }

    .brand {
        padding-bottom: 12px;
    }

    .navigation {
        display: flex;
        flex-wrap: wrap;
    }

    .sidebar-label,
    .sidebar-bottom {
        display: none;
    }

    .main-content {
        padding: 18px;
    }

    .topbar {
        align-items: flex-start;
        flex-direction: column;
    }

    .form-grid,
    .filters {
        grid-template-columns: 1fr;
    }

    .calendar {
        gap: 3px;
    }

    .calendar-day {
        min-height: 49px;
        padding: 5px;
        font-size: 12px;
    }
}
